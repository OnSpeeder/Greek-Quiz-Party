{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "packVersion", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "type": "string", "minLength": 1 },
    "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$" },
    "categories": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "nameKey"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "nameKey": { "type": "string", "minLength": 1, "maxLength": 128 } }
      }
    }
  }
}
