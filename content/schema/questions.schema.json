{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array", "maxItems": 10000,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "text", "answers", "correctAnswerIndex", "categoryId", "difficulty", "explanation", "locale", "status"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
      "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
      "answers": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
      "correctAnswerIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
      "categoryId": { "type": "string", "minLength": 1 },
      "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
      "explanation": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "source": { "type": "string", "format": "uri" },
      "locale": { "type": "string", "minLength": 1 },
      "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "status": { "enum": ["draft", "reviewed", "rejected"] },
      "verifiedAt": { "type": "string", "format": "date" },
      "expiresAfter": { "type": "string", "format": "date" }
    }
  }
}
